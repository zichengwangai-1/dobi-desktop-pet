# This repository tracks the native macOS product and its source assets.
/*
!/.gitignore
!/README.md
!/DobiNative/
!/DobiIOS/
!/启动杜宾.command
!/杜宾：小狗动作画面/

# Keep the original pet clips needed to regenerate alpha videos.
/杜宾：小狗动作画面/*
!/杜宾：小狗动作画面/杜宾/

# Build output, IDE state, and local filesystem metadata.
**/.build/
**/.swiftpm/
**/DerivedData/
**/build/
**/xcuserdata/
**/.DS_Store
**/*.xcuserstate
**/core
**/core.*
!/DobiIOS/Shared/Core/
!/DobiIOS/Shared/Core/*.swift
**/__pycache__/
**/*.pyc
